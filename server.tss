app.post('/api/system/clean-dummy-data', (req, res) => {
  try {
    const { preserveTargets = true } = req.body || {};
    sqliteDb.cleanSlateDatabase(preserveTargets);
    cachedCrowdSecAlertsRaw = [];
    cachedAggregatedDomainAlertStats = null;
    cachedMikrotikAddressList = [];
    return res.json({
      success: true,
      simulationEnabled: false,
      message: 'Seluruh data dummy dan log simulasi berhasil dibersihkan! Sistem sekarang siap untuk telemetri riil 100%.',
    });
  } catch (err: any) {
    return res.status(500).json({ success: false, error: err.message });
  }
});

app.post('/api/system/toggle-simulation', (req, res) => {
  try {
    const current = isSimulationEnabled();
    const nextState = !current;
    sqliteDb.setSetting('auto_fallback_simulation', nextState ? 'true' : 'false', 'general');
    if (!nextState) {
      cachedCrowdSecAlertsRaw = [];
      cachedAggregatedDomainAlertStats = null;
    }
    return res.json({
      success: true,
      simulationEnabled: nextState,
      message: nextState ? 'Mode simulasi diaktifkan kembali.' : 'Mode bersih (tanpa dummy) berhasil diaktifkan.',
    });
  } catch (err: any) {
    return res.status(500).json({ success: false, error: err.message });
  }
});

