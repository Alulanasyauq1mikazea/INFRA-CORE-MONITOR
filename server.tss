  "domainSummaries": {
    "storageRunoutWarning": string,
    "networkBandwidthPeak": string,
    "securityThreatTrend": string,
    "sslExpirationsCount": number
  }
}`;

    const response = await ai.models.generateContent({
      model: 'gemini-3.8-flash',
      contents: prompt,
