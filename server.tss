// User Authentication Route
app.post('/api/auth/login', (req, res) => {
  const { username, password } = req.body;

  const envAdminUser = process.env.ADMIN_USER?.trim();
  const envAdminPass = process.env.ADMIN_PASS?.trim();
  const envViewerUser = process.env.VIEWER_USER?.trim();
  const envViewerPass = process.env.VIEWER_PASS?.trim();

  // 1. Super Admin credentials (from .env or default daswafx/admin)
  const isEnvAdminMatch = envAdminUser && envAdminPass && username === envAdminUser && password === envAdminPass;
  const isDefaultAdminMatch =
    (username === 'daswafx' && (password === 'admin123' || password === 'admin')) ||
    (username === 'admin' && (password === 'admin123' || password === 'admin'));

  if (isEnvAdminMatch || isDefaultAdminMatch) {
    return res.json({
      success: true,
      requiresTotp: false,
      token: `netwatch_jwt_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`,
      user: {
        id: 'usr-admin-1',
        username: username,
        name: username === 'daswafx' ? 'Daswafx Super Admin' : (envAdminUser ? `${username} (Super Admin)` : 'System Super Admin'),
        email: process.env.ADMIN_EMAIL || 'cahyadi@unmus.ac.id',
        role: 'Super Admin',
        lastLogin: new Date().toISOString(),
      },
    });
  }

  // 2. Viewer / View Only credentials (from .env or default viewer/observer/guest)
  const isEnvViewerMatch = envViewerUser && envViewerPass && username === envViewerUser && password === envViewerPass;
  const isDefaultViewerMatch =
    (username === 'viewer' && (password === 'viewer123' || password === 'viewer')) ||
    (username === 'observer' && (password === 'observer123' || password === 'observer')) ||
    (username === 'guest' && (password === 'guest123' || password === 'guest'));

  if (isEnvViewerMatch || isDefaultViewerMatch) {
    return res.json({
      success: true,
      requiresTotp: false,
      token: `netwatch_jwt_viewer_${Date.now()}`,
      user: {
        id: 'usr-viewer-1',
        username: username,
        name: 'Guest Monitor Viewer',
        email: 'viewer@unmus.ac.id',
        role: 'Viewer',
        lastLogin: new Date().toISOString(),
      },
    });
  }

  return res.status(401).json({
    success: false,
    error: 'Username atau Password yang Anda masukkan salah.',
  });
});

app.post('/api/auth/verify-totp', (req, res) => {
  const { username, totpCode } = req.body;
  if (totpCode && totpCode.length === 6) {
    return res.json({
      success: true,
      token: `netwatch_jwt_2fa_${Date.now()}`,
      user: {
        id: 'usr-1',
        username: username || 'daswafx',
        name: 'Daswafx Administrator',
        role: 'Administrator',
        lastLogin: new Date().toISOString(),
      },
    });
  }
  return res.status(400).json({ success: false, error: 'Kode TOTP tidak valid.' });
});

app.post('/api/auth/logout', (req, res) => {
