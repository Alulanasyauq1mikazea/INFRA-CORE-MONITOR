const handleAiPredictiveAnalytics = async (req: express.Request, res: express.Response) => {
  try {
    const { nodesData } = req.body || {};
    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey || apiKey.includes('YourGemini') || apiKey === 'dummy-key') {
      throw new Error('API Key not set');
    }
    const ai = getAiClient();

    const prompt = `You are a Principal Infrastructure & Cybersecurity AI Architect specializing in University Campus Networks, MikroTik RouterOS Firewalls, Ruijie Gateways, Nginx WAF / CrowdSec ReverseProxies, Proxmox VE hypervisors, and Uptime Kuma monitoring.
Analyze the telemetry nodes and infrastructure state to produce a multi-domain predictive forecast in JSON format:
Telemetry Context:
${JSON.stringify(nodesData || {}, null, 2)}

Provide detailed projections across 4 Core Operational Domains:
1. SERVER & STORAGE: Storage runout forecast (days remaining before disk saturation >90%), RAM overcommit, and CPU spike trends for Proxmox VE nodes (Informatika, Dekanat, Teknik).
2. NETWORK & GATEWAY: WAN Uplink bandwidth saturation, NAT connection state table load, and peak hours traffic surges for MikroTik CCR1036 (192.168.77.1) and Ruijie Gateway.
3. WAF & SECURITY: Web Application Firewall threat projection (SQLi, XSS, automated credential stuffing, bot velocity) and CrowdSec ban synchronization.
4. WEB & SSL EXPIRY: SSL certificate expiration forecast (<30 days alert) and HTTP SLA response time degradation for critical campus services (SIAKAD, OJS, Web Portal).

Return ONLY valid JSON matching this schema:
{
  "overallHealthScore": number (0-100),
  "criticalPredictions": [
    {
      "nodeId": string,
      "nodeName": string,
      "domainCategory": "server" | "network" | "waf" | "ssl",
      "riskScore": number (0-100),
      "predictedExhaustionDays": number or null,
      "predictedFailureType": string,
      "confidence": number (0-100),
      "trendDirection": "increasing" | "stable" | "decreasing",
