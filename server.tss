// In-memory runtime state for Ruijie Gateway & Reyee Controller
let ruijieConfig = {
  host: process.env.RUIJIE_HOST || '192.168.110.1',
  model: 'Ruijie Reyee RG-EG3250 Multi-WAN Gateway',
  rgosVersion: 'RGOS 11.9(6)B1P1 (Release 2026.04)',
