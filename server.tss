// On-Premises Local Database Management Endpoints (Offline Hub)
// -------------------------------------------------------------
// -------------------------------------------------------------
// SQLite Real-Time Data Source & Environment Management Endpoints
// -------------------------------------------------------------
app.get('/api/database/status', (req, res) => {
  try {
    const stats = sqliteDb.getDatabaseStats();
    res.json({ success: true, stats });
  } catch (err: any) {
    res.status(500).json({ success: false, error: err.message });
  }
});

app.get('/api/database/sources', (req, res) => {
  try {
    const category = req.query.category as string | undefined;
    const sources = sqliteDb.getDataSources(category);
    res.json({ success: true, sources, count: sources.length });
  } catch (err: any) {
    res.status(500).json({ success: false, error: err.message });
  }
});

app.get('/api/database/sources/:id', (req, res) => {
  const source = sqliteDb.getDataSourceById(req.params.id);
  if (!source) {
    return res.status(404).json({ success: false, error: 'Data source tidak ditemukan.' });
  }
  res.json({ success: true, source });
});

app.post('/api/database/sources', (req, res) => {
  try {
    const { name, category, driver, endpoint_url, ip_address, port, auth_type, auth_credentials, scrape_interval_sec, is_default } = req.body;
    if (!name || (!endpoint_url && !ip_address)) {
      return res.status(400).json({ success: false, error: 'Nama dan Alamat IP/Endpoint URL wajib diisi.' });
    }
    const created = sqliteDb.createDataSource({
      name,
      category,
      driver,
      endpoint_url,
      ip_address,
      port: port ? Number(port) : 80,
      auth_type,
      auth_credentials,
      scrape_interval_sec: scrape_interval_sec ? Number(scrape_interval_sec) : 15,
      is_default: Boolean(is_default),
    });
    res.json({ success: true, message: `Sumber data "${created.name}" berhasil disimpan ke SQLite.`, source: created });
  } catch (err: any) {
    res.status(500).json({ success: false, error: err.message });
  }
});

app.put('/api/database/sources/:id', (req, res) => {
  try {
    const updated = sqliteDb.updateDataSource(req.params.id, req.body);
    if (!updated) {
      return res.status(404).json({ success: false, error: 'Data source tidak ditemukan.' });
    }
    res.json({ success: true, message: `Sumber data "${updated.name}" berhasil diperbarui di SQLite.`, source: updated });
  } catch (err: any) {
    res.status(500).json({ success: false, error: err.message });
  }
});

app.delete('/api/database/sources/:id', (req, res) => {
  try {
    const ok = sqliteDb.deleteDataSource(req.params.id);
    if (!ok) {
      return res.status(404).json({ success: false, error: 'Data source tidak ditemukan.' });
    }
    res.json({ success: true, message: 'Sumber data berhasil dihapus dari SQLite.' });
  } catch (err: any) {
    res.status(500).json({ success: false, error: err.message });
  }
});

// Live Test Probe Endpoint for Data Source (Test Connection)
app.post('/api/database/sources/test-connection', async (req, res) => {
  const { id, endpoint_url, ip_address, port } = req.body;
  const targetUrl = endpoint_url || (ip_address ? `http://${ip_address}:${port || 80}` : null);

  if (!targetUrl && !ip_address) {
    return res.status(400).json({ success: false, error: 'Target URL atau IP Address wajib disediakan untuk tes koneksi.' });
  }

  const startTime = Date.now();
  let reachable = false;
  let statusCode = 0;
  let responseTimeMs = 0;
  let statusText = '';
  let errorMsg: string | null = null;

  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 2500);

    const probeTarget = targetUrl?.startsWith('http') ? targetUrl : `http://${ip_address}:${port || 80}`;
    const resp = await fetch(probeTarget, {
      method: 'GET',
      headers: { 'User-Agent': 'NetWatch-Pro-Probe/3.0' },
      signal: controller.signal,
    }).catch(err => {
      errorMsg = err.name === 'AbortError' ? 'Koneksi timeout (2.5 detik)' : err.message;
      return null;
    });

    clearTimeout(timeoutId);
    responseTimeMs = Date.now() - startTime;

    if (resp) {
      reachable = true;
      statusCode = resp.status;
      statusText = resp.statusText || 'OK';
    }
  } catch (err: any) {
    responseTimeMs = Date.now() - startTime;
    errorMsg = err.message;
  }

  // If in cloud environment without direct subnet reachability, provide realistic diagnostic feedback
  const finalStatus = reachable ? 'online' : 'offline';
  
  if (id) {
    sqliteDb.updateDataSource(id, {
      last_status: finalStatus,
      last_latency_ms: responseTimeMs,
      last_error: errorMsg,
      last_checked_at: new Date().toISOString(),
    });
  }

  return res.json({
    success: true,
    reachable,
    status: finalStatus,
    statusCode,
    statusText,
    responseTimeMs,
    error: errorMsg,
    targetTested: targetUrl || `${ip_address}:${port || 80}`,
    timestamp: new Date().toISOString(),
    diagnosticHint: reachable ? 'Koneksi Berhasil' : 'Target tidak merespons HTTP (mungkin port berbeda atau firewall/LAN lokal)',
  });
});

app.post('/api/database/sources/:id/test', async (req, res) => {
  const ds = sqliteDb.getDataSourceById(req.params.id);
  if (!ds) {
    return res.status(404).json({ success: false, error: 'Data source tidak ditemukan.' });
  }

  const startTime = Date.now();
  let reachable = false;
  let statusCode = 0;
  let responseTimeMs = 0;
  let errorMsg: string | null = null;

  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 2500);
    const resp = await fetch(ds.endpoint_url, {
      method: 'GET',
      headers: { 'User-Agent': 'NetWatch-Pro-Probe/3.0' },
      signal: controller.signal,
    }).catch(err => {
      errorMsg = err.name === 'AbortError' ? 'Koneksi timeout (2.5 detik)' : err.message;
      return null;
    });

    clearTimeout(timeoutId);
    responseTimeMs = Date.now() - startTime;

    if (resp) {
      reachable = true;
      statusCode = resp.status;
    }
  } catch (err: any) {
    responseTimeMs = Date.now() - startTime;
    errorMsg = err.message;
  }

  const finalStatus = reachable ? 'online' : 'offline';
  sqliteDb.updateDataSource(ds.id, {
    last_status: finalStatus,
    last_latency_ms: responseTimeMs,
    last_error: errorMsg,
    last_checked_at: new Date().toISOString(),
  });

  return res.json({
    success: true,
    sourceId: ds.id,
    name: ds.name,
    reachable,
    status: finalStatus,
    statusCode,
    responseTimeMs,
    error: errorMsg,
  });
});

