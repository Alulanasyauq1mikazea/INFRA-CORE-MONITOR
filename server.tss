// Update & Save Custom Targets API (Persisted to SQLite DB)
app.post('/api/prometheus/targets', (req, res) => {
  const { targets } = req.body;
  if (Array.isArray(targets)) {
    userPrometheusTargetsStore = targets;
    
    // Persist to SQLite DB
    sqliteDb.batchUpsertTargets(targets, 'Prometheus Save');

    return res.json({
      success: true,
      message: 'Berhasil menyimpan daftar target Prometheus ke SQLite Database (netwatch.db).',
      count: targets.length,
      storage: 'sqlite3_native',
    });
  }
  return res.status(400).json({ success: false, message: 'Payload target tidak valid' });
});

// Get current saved Prometheus Host
app.get('/api/prometheus/current-host', (req, res) => {
  const saved = sqliteDb.getSetting('default_prometheus_host', process.env.PROMETHEUS_HOST || 'http://192.168.77.30:9090');
  return res.json({ success: true, promHost: saved });
});

// Sync & Fetch Real Targets from any custom Prometheus Server (http://<ip>:9090)
app.post('/api/prometheus/sync-live-host', async (req, res) => {
  let { promHost } = req.body || {};
  if (!promHost || typeof promHost !== 'string') {
    promHost = sqliteDb.getSetting('default_prometheus_host', process.env.PROMETHEUS_HOST || 'http://192.168.77.30:9090');
  }

  promHost = promHost.trim();
  if (!promHost.startsWith('http://') && !promHost.startsWith('https://')) {
    promHost = `http://${promHost}`;
  }
  try {
    const parsed = new URL(promHost);
    promHost = `${parsed.protocol}//${parsed.host}`;
  } catch {
    promHost = promHost
      .replace(/\/classic.*$/i, '')
      .replace(/\/targets.*$/i, '')
      .replace(/\/graph.*$/i, '')
      .replace(/\/api.*$/i, '')
      .replace(/\/+$/, '');
  }

  const startTime = Date.now();
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 4000);

    const targetUrl = `${promHost}/api/v1/targets`;
    const response = await fetch(targetUrl, { signal: controller.signal });
    clearTimeout(timeoutId);

    if (!response.ok) {
      return res.status(response.status).json({
        success: false,
        error: `Server Prometheus di ${promHost} merespons dengan HTTP ${response.status} (${response.statusText}).`,
        promHost,
      });
    }

    const payload = await response.json();
    if (!payload.data || !Array.isArray(payload.data.activeTargets)) {
      return res.status(400).json({
        success: false,
        error: 'Format data dari endpoint /api/v1/targets tidak sesuai dengan struktur resmi Prometheus API.',
        promHost,
      });
    }

    const rawActiveTargets = payload.data.activeTargets;
    if (rawActiveTargets.length === 0) {
      userPrometheusTargetsStore = [];
      sqliteDb.replaceAllTargets([], `Prometheus Live Sync (0 Targets - ${promHost})`);
      sqliteDb.setSetting('default_prometheus_host', promHost, 'metrics');

      return res.json({
        success: true,
        count: 0,
        promHost,
        activeTargets: [],
        message: `Terhubung ke Prometheus di ${promHost}, namun saat ini ada 0 target yang terdaftar pada file prometheus.yml server tersebut.`,
      });
    }

    // Map each real Prometheus active target into application model
    const mappedTargets: any[] = rawActiveTargets.map((lt: any, idx: number) => {
      const job = lt.labels?.job || lt.discoveredLabels?.job || lt.scrapePool || `job-${idx + 1}`;
      const instance = lt.labels?.instance || lt.discoveredLabels?.__address__ || '';
      const isUp = lt.health === 'up';
      const jobLower = String(job).toLowerCase();

      // Automatic classification
      let mappedModule = 'server';
      if (jobLower.includes('mikrotik') || jobLower.includes('router') || jobLower.includes('snmp')) {
        mappedModule = 'mikrotik';
      } else if (jobLower.includes('crowdsec') || jobLower.includes('waf') || jobLower.includes('nginx') || jobLower.includes('security')) {
        mappedModule = 'waf';
      } else if (jobLower.includes('blackbox') || jobLower.includes('kuma') || jobLower.includes('website') || jobLower.includes('probe')) {
        mappedModule = 'website';
      } else if (jobLower.includes('prometheus') || jobLower === 'system') {
        mappedModule = 'system';
      } else {
        mappedModule = 'server';
      }

      // Extract IP from instance
      let instanceIp = instance.split(':')[0] || '127.0.0.1';
      if (instanceIp.startsWith('http://') || instanceIp.startsWith('https://')) {
        try {
          const u = new URL(instanceIp);
          instanceIp = u.hostname;
        } catch {}
      }

      // Friendly Node Name
      let nodeName = lt.labels?.node_name || lt.labels?.server_name || '';
      if (!nodeName) {
        if (jobLower.includes('mikrotik')) nodeName = `MikroTik Gateway (${instanceIp})`;
        else if (jobLower.includes('crowdsec')) nodeName = `CrowdSec WAF (${instanceIp})`;
        else if (jobLower.includes('node')) nodeName = `Linux Host (${instanceIp})`;
        else if (jobLower.includes('pve') || jobLower.includes('proxmox')) nodeName = `Proxmox Node (${instanceIp})`;
        else if (jobLower.includes('blackbox')) nodeName = `Blackbox Probe (${instanceIp})`;
        else nodeName = `${job.toUpperCase()} Node (${instanceIp})`;
      }

      // Exporter Type
      let exporterType = 'Prometheus Exporter';
      if (jobLower.includes('node')) exporterType = 'Node Exporter';
      else if (jobLower.includes('snmp')) exporterType = 'SNMP Exporter (MikroTik RouterOS MIB)';
      else if (jobLower.includes('pve')) exporterType = 'Proxmox VE Exporter';
      else if (jobLower.includes('blackbox')) exporterType = 'Blackbox Exporter Probe';
      else if (jobLower.includes('crowdsec')) exporterType = 'CrowdSec Prometheus Metrics Exporter';
      else exporterType = `${job} Exporter`;

      const scrapeDurationMs = lt.lastScrapeDuration ? Math.round(lt.lastScrapeDuration * 1000) : 12;
      const scrapeDurationStr = `${scrapeDurationMs}ms`;

      // Metrics default selection
      let selectedMetrics = [
        'node_cpu_seconds_total',
        'node_memory_MemTotal_bytes',
        'node_memory_MemAvailable_bytes',
        'node_filesystem_free_bytes'
      ];
      if (mappedModule === 'mikrotik') {
        selectedMetrics = ['mtxrInterfaceStatsDriverRxBytes', 'mtxrInterfaceStatsDriverTxBytes', 'ifHCInOctets', 'ifHCOutOctets'];
      } else if (mappedModule === 'waf') {
        selectedMetrics = ['cs_active_decisions', 'cs_alerts_total', 'cs_lapi_requests_total'];
      } else if (mappedModule === 'website') {
        selectedMetrics = ['probe_success', 'probe_http_status_code', 'probe_duration_seconds'];
      }

      const id = `tgt-live-${job}-${instance.replace(/[^a-zA-Z0-9_-]/g, '_')}-${idx + 1}`;
      const endpoint = lt.scrapeUrl || lt.globalUrl || (instance ? `http://${instance}/metrics` : `${promHost}/metrics`);

      return {
        id,
        job: String(job),
        jobName: String(job),
        endpoint,
        instanceIp,
        module: mappedModule,
        mappedModule,
        nodeName,
        mappedNodeName: nodeName,
        state: isUp ? 'UP' : 'DOWN',
        health: lt.health,
        isPaused: false,
        responseTimeMs: scrapeDurationMs,
        scrapeInterval: lt.scrapeInterval || '15s',
        scrapeDuration: scrapeDurationStr,
        exporterType,
        installedOnTarget: true,
        labels: lt.labels || {},
        selectedMetrics,
        healthReason: lt.lastError || '',
        lastScrape: lt.lastScrape ? `${Math.max(1, Math.round((Date.now() - new Date(lt.lastScrape).getTime()) / 1000))}s ago` : '3s ago',
      };
    });

    // 1. Overwrite SQLite prometheus_targets with the real ones
    sqliteDb.replaceAllTargets(mappedTargets, `Prometheus Live Sync (${promHost})`);
    // 2. Persist Prometheus host setting
    sqliteDb.setSetting('default_prometheus_host', promHost, 'metrics');
    // 3. Update data_sources ds-prom-main
    try {
      const promUrlObj = new URL(promHost);
      sqliteDb.updateDataSource('ds-prom-main', {
        endpoint_url: promHost,
        ip_address: promUrlObj.hostname,
        port: parseInt(promUrlObj.port || '9090', 10),
        status: 'active',
        last_status: 'online',
        last_latency_ms: Date.now() - startTime,
      });
    } catch {}

    // 4. Update in-memory store
    userPrometheusTargetsStore = mappedTargets;

    return res.json({
      success: true,
      count: mappedTargets.length,
      promHost,
      activeTargets: mappedTargets,
      latencyMs: Date.now() - startTime,
      message: `Berhasil terhubung ke ${promHost}! Ditemukan dan disinkronkan ${mappedTargets.length} target aktif dari server Prometheus Anda.`,
    });
  } catch (err: any) {
    return res.status(500).json({
      success: false,
      reachable: false,
      promHost,
      error: `Tidak dapat menghubungi Prometheus di ${promHost}: ${err.message || 'Koneksi gagal atau timeout'}. Pastikan service Prometheus aktif dan port 9090 dapat diakses.`,
    });
  }
});

