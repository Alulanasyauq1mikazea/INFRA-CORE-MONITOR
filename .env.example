# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# NetWatch Monitoring System - Environment Configuration
# =========================================================================

# --- SERVER RUNTIME ---
PORT=3000
NODE_ENV=development

# --- MIKROTIK ROUTEROS REST API & SNMP ---
MIKROTIK_HOST=192.168.5.1
MIKROTIK_REST_PORT=80
MIKROTIK_USER=netwatch
MIKROTIK_PASS=
MIKROTIK_SNMP_COMMUNITY=public
MIKROTIK_USE_SSL=false

# --- WAF & CROWDSEC LAPI (CYBER SECURITY ENGINE) ---
CROWDSEC_HOST=192.168.77.77
CROWDSEC_METRICS_PORT=6060
CROWDSEC_METRICS_URL=http://192.168.77.77:6060/metrics
CROWDSEC_LAPI_PORT=8181
CROWDSEC_LAPI_URL=http://192.168.77.77:8181
CROWDSEC_API_KEY=your_crowdsec_api_key_here

# --- BASE DOMAIN / INSTITUTION ---
# Ganti dengan domain utama institusi/perusahaan jika pindah ke lingkungan lain (default: unmus.ac.id)
BASE_DOMAIN=unmus.ac.id

# --- PROMETHEUS METRICS SCRAPER ---
PROMETHEUS_HOST=http://192.168.77.30:9090

# --- RUIJIE GATEWAY ---
RUIJIE_HOST=192.168.110.1

# --- SYSTEM SUPER ADMIN LOGIN ---
ADMIN_USER=daswafx
ADMIN_PASS=admin123

