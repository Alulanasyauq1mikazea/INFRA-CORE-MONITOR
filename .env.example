# ==============================================================================
# SentinelPulse Monitoring Dashboard - Environment Configuration
# ==============================================================================
# Any variable defined here will override config.json automatically.

# Server Settings
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
DEMO_FALLBACK_ENABLED=true
POLL_INTERVAL_MS=4000

# Storage
SQLITE_PATH=./data/sentinel.sqlite
DATA_RETAIN_DAYS=7

# 1. Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_ENDPOINT=http://192.168.1.100:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TIMEOUT_MS=5000

# 2. MikroTik RouterOS (v7 REST or Web API)
MIKROTIK_ENABLED=true
MIKROTIK_HOST=https://192.168.1.1
MIKROTIK_PORT=443
MIKROTIK_PROTOCOL=rest
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=
MIKROTIK_INSECURE_TLS=true
MIKROTIK_TIMEOUT_MS=5000

# 3. CrowdSec (Exporter & LAPI)
CROWDSEC_ENABLED=true
CROWDSEC_EXPORTER_ENDPOINT=http://192.168.1.105:6060/metrics
CROWDSEC_LAPI_ENDPOINT=http://192.168.1.105:8080
CROWDSEC_API_KEY=
CROWDSEC_MACHINE_ID=sentinel-watcher
CROWDSEC_TIMEOUT_MS=5000

# 4. Uptime Kuma
UPTIME_KUMA_ENABLED=true
UPTIME_KUMA_ENDPOINT=http://192.168.1.110:3001
UPTIME_KUMA_API_KEY=
UPTIME_KUMA_SLUG=default
UPTIME_KUMA_METRICS_ENDPOINT=http://192.168.1.110:3001/metrics
UPTIME_KUMA_TIMEOUT_MS=5000

# 5. Proxmox VE (PVE Exporter / API)
PROXMOX_ENABLED=true
PROXMOX_EXPORTER_ENDPOINT=http://192.168.1.120:9221/pve
PROXMOX_API_ENDPOINT=https://192.168.1.120:8006
PROXMOX_TOKEN_ID=root@pam!monitoring
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=false
PROXMOX_CLUSTER_NAME=PVE-Cluster-01
PROXMOX_TIMEOUT_MS=5000

# Gemini API key (optional AI insights)
GEMINI_API_KEY=
