# =========================================================================
# NetWatch Monitoring System - Environment Configuration (.env.example)
# Salin file ini menjadi `.env` di root direktori project:
# cp .env.example .env
# =========================================================================

# --- SERVER RUNTIME ---
PORT=3000
NODE_ENV=production

# --- MIKROTIK ROUTEROS REST API & SNMP ---
# Masukkan IP router MikroTik Anda (misal gateway LAN 192.168.5.1 atau 192.168.1.1)
MIKROTIK_HOST=192.168.5.1
MIKROTIK_REST_PORT=80
MIKROTIK_USER=netwatch
MIKROTIK_PASS=
MIKROTIK_SNMP_COMMUNITY=public
MIKROTIK_USE_SSL=false

# --- WAF & CROWDSEC LAPI (CYBER SECURITY ENGINE) ---
# IP server tempat CrowdSec LAPI / Nginx WAF berjalan
CROWDSEC_HOST=192.168.77.77
CROWDSEC_METRICS_PORT=6060
CROWDSEC_METRICS_URL=http://192.168.77.77:6060/metrics
# Port LAPI: 8181 (NPMPlus Docker) atau 8080 (CrowdSec standar)
CROWDSEC_LAPI_PORT=8181
CROWDSEC_LAPI_URL=http://192.168.77.77:8181
CROWDSEC_API_KEY=8ykywMNr4rrmlcjSgcmeiMp9Muq0RJmqTVb5Xp0chD8

# --- PROMETHEUS METRICS SCRAPER ---
PROMETHEUS_HOST=http://192.168.77.30:9090

# --- RUIJIE GATEWAY ---
RUIJIE_HOST=192.168.110.1

# --- SYSTEM SUPER ADMIN LOGIN ---
ADMIN_USER=daswafx
ADMIN_PASS=admin123
